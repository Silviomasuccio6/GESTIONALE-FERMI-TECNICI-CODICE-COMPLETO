# API pubblica Fleetum usata da richiesta demo e analytics first-party.
NEXT_PUBLIC_API_URL=https://api.fleetum.it/api

# Dominio canonico del sito pubblico.
NEXT_PUBLIC_SITE_URL=https://fleetum.it

# Login dell'app Fleetum. La Platform Console founder-only non va esposta nel sito.
NEXT_PUBLIC_APP_LOGIN_URL=https://fleetum.it/login

# Lasciare false nelle preview private. Attivare solo al cutover pubblico.
NEXT_PUBLIC_SITE_INDEXABLE=false
