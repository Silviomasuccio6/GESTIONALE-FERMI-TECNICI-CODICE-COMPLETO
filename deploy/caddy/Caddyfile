{
	email {$CADDY_EMAIL}
}

(security_headers) {
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Strict-Transport-Security "max-age=15552000"
		-Server
		defer
	}
}

(frontend_cache_headers) {
	@html path / /index.html /platform.html /spa.html
	header @html Cache-Control "no-cache"
}

(secure_error_responses) {
	handle_errors {
		import security_headers
		respond "{err.status_code} {err.status_text}" {err.status_code}
	}
}

fleetum.it, www.fleetum.it {
	import security_headers
	import frontend_cache_headers
	import secure_error_responses
	encode zstd gzip

	route {
		handle /api/* {
			reverse_proxy backend:4000
		}

		@legacy_software_autonoleggio path /software-autonoleggio /software-autonoleggio/*
		redir @legacy_software_autonoleggio /prodotto 308

		@legacy_software_rent_a_car path /software-rent-a-car /software-rent-a-car/*
		redir @legacy_software_rent_a_car /soluzioni 308

		@legacy_contracts path /contratti-noleggio-digitali /contratti-noleggio-digitali/*
		redir @legacy_contracts /contratti-digitali 308

		@legacy_profitability path /report-redditivita-veicolo /report-redditivita-veicolo/*
		redir @legacy_profitability /gestionale-flotta 308

		@website_assets path /_next/*
		handle @website_assets {
			root * /srv/fleetum-website
			header Cache-Control "public, max-age=31536000, immutable"
			file_server
		}

		handle /brand/* {
			root * /srv/fleetum
			header Cache-Control "public, max-age=86400"
			file_server
		}

		handle /assets/* {
			root * /srv/fleetum
			header Cache-Control "public, max-age=31536000, immutable"
			file_server
		}

		@marketing {
			path / /accesso /accesso/* /booking-noleggi /booking-noleggi/* /chi-siamo /chi-siamo/* /come-funziona /come-funziona/* /contratti-digitali /contratti-digitali/* /cookie /cookie/* /demo /demo/* /dpa /dpa/* /gestionale-flotta /gestionale-flotta/* /moduli /moduli/* /prezzi /prezzi/* /privacy /privacy/* /prodotto /prodotto/* /scadenze-manutenzione /scadenze-manutenzione/* /sicurezza /sicurezza/* /soluzioni /soluzioni/* /termini /termini/* /tour /tour/* /robots.txt /sitemap.xml /llms.txt
		}
		handle @marketing {
			root * /srv/fleetum-website
			try_files {path} {path}/index.html /404.html
			file_server
		}

		# Login, onboarding and tenant routes remain on the existing Fleetum SPA.
		handle {
			header X-Robots-Tag "noindex, nofollow, noarchive"
			root * /srv/fleetum
			try_files {path} /spa.html
			file_server
		}
	}
}

api.fleetum.it {
	import security_headers
	encode zstd gzip
	header X-Robots-Tag "noindex, nofollow, noarchive"

	route /api/* {
		reverse_proxy backend:4000
	}

	respond "Fleetum API" 200
}

platform.fleetum.it {
	import security_headers
	import frontend_cache_headers
	import secure_error_responses
	encode zstd gzip
	header X-Robots-Tag "noindex, nofollow, noarchive"

	route /platform-api/* {
		reverse_proxy backend:4100
	}

	route /assets/* {
		root * /srv/fleetum
		file_server
	}

	route /brand/* {
		root * /srv/fleetum
		file_server
	}

	route {
		root * /srv/fleetum
		try_files {path} /platform.html
		file_server
	}
}
